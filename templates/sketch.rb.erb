# frozen_string_literal: true

require_relative "../../lib/studio"

<% if type == "object" -%>
# <%= title %> — Object-to-Art sketch
# Define Ruby domain objects with `include Asobi::Art` and `def to_art`.

class NodeGlyph
  include Asobi::Art

  def initialize(size:, orbit_radius:, color:, period:)
    @size = size
    @orbit_radius = orbit_radius
    @color = color
    @period = period
  end

  def to_art
    track = ring(@orbit_radius, 0.5).colored(:dimgray).opacity(0.45)
    body = circle(@size).colored(@color).glowing(2).orbit(@orbit_radius, every: @period)
    track + body
  end
end

palette = Studio::Palettes::MIDNIGHT_NEON
nodes = [
  NodeGlyph.new(size: 6, orbit_radius: 28, color: palette[0], period: 4),
  NodeGlyph.new(size: 8, orbit_radius: 50, color: palette[1], period: 6),
  NodeGlyph.new(size: 5, orbit_radius: 74, color: palette[2], period: 9)
]

core = star(14, 6).colored(palette[0]).spin(every: 12)
scene = core + nodes.reduce(:+)

show scene, on: Studio::Palettes.bg(:night), paper: [220, 220], grain: true
<% elsif type == "interactive" -%>
# <%= title %> — Interactive / Audio-Reactive sketch
# Drop an audio track into this folder and uncomment the next line for music reactivity:
# play "track.mp3", volume: 0.7

palette = Studio::Palettes::SOLAR_DRIFT

pads = polygon(6, 14).colored(*palette)
         .pulse(1.35, every: 0.45)
         .when_clicked.sounding(:bell)
         .repeat(8).in_ring(56)

kick_ring = ring(28, 2).colored(palette[0])
              .pulse(1.25, every: 0.35)
              .when_pressed("a").sounding(:kick)
              .glowing(2)

center = circle(12).colored(palette[2])
           .pulse(1.3, every: 0.5).on_beat

show (kick_ring + center + pads), on: Studio::Palettes.bg(:ink), paper: [220, 220]
<% else -%>
# <%= title %> — Generative looping sketch

palette = Studio::Palettes::MIDNIGHT_NEON
motif = petal(34, 10).move(up: 18)
rosette = motif.repeat(12).in_fan.colored(*palette)
inner = star(14, 6).colored(palette[0]).spin(every: 6, clockwise: false)

piece = rosette.spin(every: 10).glowing(2) + inner

show piece, on: Studio::Palettes.bg(:night), paper: [220, 220], grain: true
<% end -%>
